
AEGIS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegis
AEGIS_SECRET_KEY=change-me-in-production
AEGIS_DEBUG=false
AEGIS_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Recipient of the blocking alert for tickets from critical sources (e.g. log-watcher).
# Leave empty to disable the alert.
AEGIS_CRITICAL_ALERT_EMAIL=
